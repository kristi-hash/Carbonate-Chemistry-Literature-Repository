      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Impacts of Seawater pH Buffering on the Larval Microbiome and Carry-Over Effects on Later-Life Disease Susceptibility in Pacific Oysters</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:identifier>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">10.1128/aem.01654-22</rdf:li>
        </rdf:Alt>
      </dc:identifier>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Clara L. Mackenzie</rdf:li>
          <rdf:li>Christopher M. Pearce</rdf:li>
          <rdf:li>Sarah Leduc</rdf:li>
          <rdf:li>Daniel Roth</rdf:li>
          <rdf:li>Colleen T. E. Kellogg</rdf:li>
          <rdf:li>Rute B. G. Clemente-Carvalho</rdf:li>
          <rdf:li>Timothy J. Green</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Invertebrate Microbiology</rdf:li>
          <rdf:li xml:lang="x-repair">Invertebrate Microbiology</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Crassostrea</rdf:li>
          <rdf:li>disease susceptibility</rdf:li>
